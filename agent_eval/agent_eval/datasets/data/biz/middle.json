    {
      "id": "mid_toolread_001",
      "domain": "account",
      "capability": [
        "tool_call",
        "state_read"
      ],
      "tier": "Middle",
      "difficulty": "medium",
      "steps": 2,
      "tools": 2,
      "instruction": "读取账户 [NAME] 的当前余额，若为负数则调整为 0",
      "setup": {
        "accounts": {
          "Alice": {
            "balance": -5
          },
          "Bob": {
            "balance": 20
          }
        }
      },
      "params": [
        {
          "name": "NAME",
          "generator": "choice",
          "choices": [
            "Alice",
            "Bob"
          ]
        }
      ],
      "available_tools": [
        "read",
        "set"
      ],
      "expected_outcome": "先 read 余额；若负则 set 为 0（Alice 场景应被修正，Bob 不变）",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "accounts",
                "Alice",
                "balance"
              ],
              "value": "0"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "state_unchanged",
            "args": {
              "path": [
                "accounts",
                "Bob",
                "balance"
              ]
            }
          },
          {
            "fn": "len_eq",
            "args": {
              "path": [
                "accounts"
              ],
              "length": 2
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "tool_call",
        "state_read",
        "conditional"
      ],
      "expectation": "",
      "env": {
        "backend": "memory"
      }
