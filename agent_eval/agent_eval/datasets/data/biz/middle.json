      "tier": "Middle",
      "difficulty": "medium",
      "steps": 2,
      "tools": 1,
      "instruction": "将 target 的值改为 [VAL]，注意首次调用可能失败，请重试",
      "setup": {
        "target": {
          "value": "x"
        },
        "_fail_first_call": true
      },
      "params": [
        {
          "name": "VAL",
          "generator": "int"
        }
      ],
      "available_tools": [
        "set"
      ],
      "expected_outcome": "target.value == [VAL] 且存在成功写步骤（从错误中恢复）",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "target",
                "value"
              ],
              "value": "[VAL]"
            }
          },
          {
            "fn": "wrote_after_error"
          }
        ],
        "pass_to_pass": [
          {
            "fn": "len_eq",
            "args": {
              "path": [],
              "length": 2
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "error_recovery",
        "retry"
      ],
      "expectation": "",
      "env": {
        "backend": "memory"
