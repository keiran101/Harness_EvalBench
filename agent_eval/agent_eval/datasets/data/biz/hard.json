        "read",
        "set"
      ],
      "expected_outcome": "reported 含 timeout(30) 与 max_conn(100)；30>3 → retry 改为 6",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "reported_value",
            "args": {
              "value_path": [
                "config",
                "timeout"
              ]
            }
          },
          {
            "fn": "reported_value",
            "args": {
              "value_path": [
                "config",
                "max_conn"
              ]
            }
          },
          {
            "fn": "state_eq",
            "args": {
