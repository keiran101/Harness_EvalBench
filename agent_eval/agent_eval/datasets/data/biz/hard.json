    {
      "id": "hard_multitool_001",
      "domain": "files",
      "capability": [
        "tool_call"
      ],
      "tier": "hard",
      "difficulty": "hard",
      "steps": 3,
      "tools": 3,
      "instruction": "把 report.txt 权限设 [PERM]，owner 改 admin，并删除临时文件 tmp.txt",
      "setup": {
        "files": {
          "report.txt": {
            "perm": "rw",
            "owner": "guest"
          },
          "tmp.txt": {
            "perm": "r"
          }
        }
      },
      "params": [
        {
          "name": "PERM",
          "generator": "perm"
        }
      ],
      "available_tools": [
        "set",
        "delete"
      ],
      "expected_outcome": "report.txt.perm==[PERM]、owner==admin；tmp.txt 已删；files 仅 report.txt",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "files",
                "report.txt",
                "perm"
              ],
              "value": "[PERM]"
            }
          },
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "files",
                "report.txt",
                "owner"
              ],
              "value": "admin"
            }
          },
          {
            "fn": "not_contains",
            "args": {
              "path": [
                "files"
              ],
              "value": "tmp.txt"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "len_eq",
            "args": {
              "path": [
                "files"
              ],
              "length": 1
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "tool_call",
        "multi_tool",
        "chained",
        "delete"
      ],
      "expectation": "综合：多工具链 + 删除",
      "env": {
        "backend": "memory"
      }
    },
    {
