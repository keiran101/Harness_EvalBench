        "set"
      ],
      "expected_outcome": "read amount(1500>1000)，set review='manual'；订单仅此一条",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "orders",
                "ORD-5001",
                "review"
              ],
              "value": "manual"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "len_eq",
            "args": {
              "path": [
                "orders"
              ],
              "length": 1
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "state_read",
        "conditional_branch",
        "threshold"
      ],
      "expectation": "综合：阈值分支写",
      "env": {
        "backend": "memory"
      }
    },
    {
      "id": "hard_errorrec_multi_001",
      "domain": "state",
      "capability": [
        "error_recovery",
        "tool_call",
        "state_read"
      ],
      "tier": "hard",
      "difficulty": "hard",
      "steps": 3,
      "tools": 2,
      "instruction": "将 target 改为 [VAL]，再把 mirror 同步为该值（首步可能失败请重试）",
      "setup": {
        "target": {
          "value": "x"
        },
        "mirror": {
          "value": "x"
        },
        "_fail_first_call": true
      },
      "params": [
        {
          "name": "VAL",
          "generator": "int"
        }
      ],
      "available_tools": [
        "read",
        "set"
      ],
      "expected_outcome": "target.value==[VAL] 且 mirror.value==[VAL]，且有恢复写步骤",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "target",
                "value"
              ],
              "value": "[VAL]"
            }
          },
          {
            "fn": "state_eq",
            "args": {
              "path": [
                "mirror",
                "value"
              ],
              "value": "[VAL]"
            }
          },
          {
            "fn": "wrote_after_error"
          }
        ],
        "pass_to_pass": [
          {
            "fn": "len_eq",
            "args": {
              "path": [],
              "length": 2
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "error_recovery",
        "sync",
        "multi_state",
        "composite"
      ],
      "expectation": "综合：错误恢复 + 双状态同步",
      "env": {
        "backend": "memory"
      }
    },
