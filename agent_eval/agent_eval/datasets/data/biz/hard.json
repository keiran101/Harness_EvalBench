          }
        ],
        "pass_to_pass": [
          {
            "fn": "state_unchanged",
            "args": {
              "path": [
                "config",
                "timeout"
              ]
            }
          },
          {
            "fn": "state_unchanged",
            "args": {
              "path": [
                "config",
                "max_conn"
              ]
            }
          }
        ]
