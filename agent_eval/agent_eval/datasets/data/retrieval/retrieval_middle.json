      "id": "middle_retrieval_001",
      "domain": "retrieval",
      "capability": ["retrieval"],
      "tier": "middle",
      "difficulty": "medium",
      "steps": 5,
      "tools": 3,
      "instruction": "项目有多个子目录，请找出所有配置相关文件（config/ 下与根目录的 settings.yaml）并汇报其关键项；tmp/ 与 logs/ 里是运行产物，无需读取",
      "setup": {
        "config/app.conf": "app.conf: 监听端口 8080",
        "config/db.conf": "db.conf: 连接池 20",
        "settings.yaml": "settings: 时区 Asia/Shanghai",
        "tmp/cache.tmp": "临时缓存，忽略",
        "logs/run.log": "运行日志，忽略"
      },
      "params": [],
      "available_tools": ["read", "ls", "find"],
      "expected_outcome": "读全 3 个配置文件（config/app.conf、config/db.conf、settings.yaml），覆盖率=1；tmp/ 与 logs/ 为干扰项不应读",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {"fn": "reported_file_value", "args": {"path": "config/db.conf"}}
        ],
        "pass_to_pass": [
          {"fn": "file_not_exists", "args": {"path": "tmp/modified.tmp"}},
          {"fn": "file_content_eq", "args": {"path": "logs/run.log", "value": "运行日志，忽略"}}
        ]
      },
      "grader": {"type": "rule"},
      "leak_guard": {},
      "tags": ["retrieval", "nested_dir", "distractor"],
      "expectation": "",
      "env": {"backend": "disk"},
      "reference_plan": [
        {"tool": "ls", "args": {"path": "."}},
        {"tool": "read", "args": {"path": "config/app.conf"}},
        {"tool": "read", "args": {"path": "config/db.conf"}},
        {"tool": "read", "args": {"path": "settings.yaml"}}
      ],
      "reference_answer": "app.conf: 监听端口 8080 | db.conf: 连接池 20 | settings: 时区 Asia/Shanghai",
      "gold_docs": ["config/app.conf", "config/db.conf", "settings.yaml"]
    },
