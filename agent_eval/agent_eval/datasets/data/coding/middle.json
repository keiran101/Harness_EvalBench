        "fs",
        "edit",
        "multi_field",
        "chained"
      ],
      "expectation": "",
      "env": {
        "backend": "disk"
      },
      "reference_plan": [
        {
          "tool": "read",
          "args": {
            "path": "config.json"
          }
        },
        {
          "tool": "write",
          "args": {
            "path": "config.json",
            "content": "{\"timeout\": [VAL], \"debug\": false, \"host\": \"example.com\"}"
          }
        }
      ],
      "reference_answer": "done"
