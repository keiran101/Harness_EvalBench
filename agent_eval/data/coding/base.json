    {
      "id": "base_fs_edit_001",
      "domain": "coding",
      "capability": [
        "tool_call",
        "state_read"
      ],
      "tier": "base",
      "difficulty": "easy",
      "steps": 1,
      "tools": 2,
      "instruction": "把 config.json 的 timeout 改为 [VAL]，保留其他字段",
      "setup": {
        "config.json": "{\"timeout\": 10, \"host\": \"example.com\"}"
      },
      "params": [
        {
          "name": "VAL",
          "generator": "int"
        }
      ],
      "available_tools": [
        "read",
        "write"
      ],
      "expected_outcome": "config.json.timeout == [VAL] 且 host 保留",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "json_field_eq",
            "args": {
              "path": "config.json",
              "field": "timeout",
              "value": "[VAL]"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "json_field_eq",
            "args": {
              "path": "config.json",
              "field": "host",
              "value": "example.com"
            }
          },
          {
            "fn": "dir_entries_eq",
            "args": {
              "paths": [
                "config.json"
              ]
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "fs",
        "edit",
        "multi_field"
      ],
      "expectation": "",
      "env": {
        "backend": "disk"
      },
      "reference_plan": [
        {
          "tool": "read",
          "args": {
            "path": "config.json"
          }
        },
        {
          "tool": "write",
          "args": {
            "path": "config.json",
            "content": "{\"timeout\": [VAL], \"host\": \"example.com\"}"
          }
        }
      ],
      "reference_answer": "done"
    },
