      "id": "hard_fs_pipeline_001",
      "domain": "coding",
      "capability": [
        "tool_call",
        "state_read"
      ],
      "tier": "hard",
      "difficulty": "hard",
      "steps": 3,
      "tools": 2,
      "instruction": "读取 nums.txt（逗号分隔），写出 max.txt（最大值）与 min.txt（最小值）",
      "setup": {
        "nums.txt": "3,9,1,7"
      },
      "params": [],
      "available_tools": [
        "read",
        "write"
      ],
      "expected_outcome": "max.txt=='9'、min.txt=='1'；nums.txt 不变",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "file_content_eq",
            "args": {
              "path": "max.txt",
              "value": "9"
            }
          },
          {
            "fn": "file_content_eq",
            "args": {
              "path": "min.txt",
              "value": "1"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "file_content_eq",
            "args": {
              "path": "nums.txt",
              "value": "3,9,1,7"
            }
          },
          {
            "fn": "dir_entries_eq",
            "args": {
              "paths": [
                "nums.txt",
                "max.txt",
                "min.txt"
              ]
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "fs",
        "transform",
        "multi_output",
        "read_compute_write"
      ],
      "expectation": "",
      "env": {
        "backend": "disk"
      },
      "reference_plan": [
        {
          "tool": "read",
          "args": {
            "path": "nums.txt"
          }
        },
        {
          "tool": "write",
          "args": {
            "path": "max.txt",
            "content": "9"
          }
        },
        {
          "tool": "write",
          "args": {
            "path": "min.txt",
            "content": "1"
          }
        }
      ],
      "reference_answer": "done"
    },
