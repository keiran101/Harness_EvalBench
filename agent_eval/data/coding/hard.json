        "pass_to_pass": [
          {
            "fn": "contains",
            "args": {
              "path": [
                "conf.json"
              ],
              "value": "[HOST]"
            }
          },
          {
            "fn": "contains",
            "args": {
              "path": [
                "conf.json"
              ],
              "value": "cache"
