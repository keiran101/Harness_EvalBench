      "setup": {
        "in.csv": "alice,90\nbob,40\ncarol,75"
      },
      "params": [],
      "available_tools": [
        "read",
        "write"
      ],
      "expected_outcome": "pass.txt 含 alice 与 carol，不含 bob；in.csv 不变",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "contains",
            "args": {
              "path": [
                "pass.txt"
              ],
              "value": "alice"
            }
          },
          {
            "fn": "contains",
            "args": {
              "path": [
                "pass.txt"
              ],
              "value": "carol"
            }
          }
        ],
        "pass_to_pass": [
          {
            "fn": "not_contains",
            "args": {
              "path": [
                "pass.txt"
              ],
              "value": "bob"
            }
          },
          {
            "fn": "file_content_eq",
            "args": {
              "path": "in.csv",
              "value": "alice,90\nbob,40\ncarol,75"
            }
          }
        ]
      },
      "grader": {
        "type": "rule"
      },
      "leak_guard": {},
      "tags": [
        "fs",
        "transform",
        "filter",
        "read_compute_write"
      ],
      "expectation": "注：pass.txt 换行顺序不敏感，contains 逐一校验成员",
      "env": {
        "backend": "disk"
      },
      "reference_plan": [
        {
          "tool": "read",
          "args": {
            "path": "in.csv"
          }
        },
        {
          "tool": "write",
          "args": {
            "path": "pass.txt",
            "content": "alice\ncarol\n"
          }
        }
      ],
      "reference_answer": "done"
    },
