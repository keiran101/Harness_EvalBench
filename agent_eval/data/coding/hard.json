          "name": "HOST",
          "generator": "email"
        },
        {
          "name": "VAL",
          "generator": "int"
        }
      ],
      "available_tools": [
        "read",
        "write"
      ],
      "expected_outcome": "db.host==[HOST]、db.port==[VAL]、cache==true",
      "must_do": [],
      "must_not_do": [],
      "verifier": {
        "fail_to_pass": [
          {
            "fn": "contains",
            "args": {
              "path": [
                "conf.json"
              ],
              "value": "[HOST]"
            }
          },
          {
            "fn": "contains",
            "args": {
              "path": [
                "conf.json"
              ],
              "value": "[VAL]"
            }
          }
