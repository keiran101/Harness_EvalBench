# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs / local artifacts
*.log
*.tmp

# Local eval outputs (regenerated by run_pi_eval.py)
agent_eval/examples/eval_pi_output.json

# Generated eval result outputs (regenerated by runs)
results/
agent_eval/eval_*.json

# Runtime logs (build/run logs, not source)
logs/

# Large binary reference PDFs (keep source text, not binaries)
papers/*.pdf

# WorkBuddy workspace memory
.workbuddy/

# Docs (local only, not synced to GitHub)
docs/

# Reports: version-controlled locally in a nested standalone git repo under
# reports/ (no remote). Excluded from this parent repo so they stay off GitHub.
reports/

# Context-capture investigation: source + report are tracked; captured runtime
# dumps (regenerable agent-session contexts) are local-only, like results/
context_capture/run1/dsh/
context_capture/run1/oc/
context_capture/run1/pi/
context_capture/run_full_oc/oc/
